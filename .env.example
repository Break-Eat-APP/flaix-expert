# FlaiX Expert — variables d'environnement du serveur (apps/api).
# Ce fichier ne contient AUCUNE valeur réelle (gouvernance § 12.3 et § 17). En local, le serveur a des valeurs par défaut
# pour le développement (apps/api/src/config.ts). Sur le serveur, les secrets sont posés par Rémi avec
# « sudo flaix-admin … » dans /etc/flaix/*.env et ne sortent jamais du serveur.

# --- Base de données ---
# Connexion du compte applicatif (soumis à l'isolement des lieux).
DATABASE_URL=
# Connexion du compte propriétaire (migrations, outils d'administration uniquement).
DATABASE_OWNER_URL=
# Mot de passe du compte applicatif, créé sur le serveur par le script de mise en ligne.
APP_DB_PASSWORD=

# --- Serveur ---
# Port d'écoute de l'API (3001 en local).
PORT=
# developpement | test | production : la bannière de l'écran et certaines protections en dépendent.
FLAIX_ENVIRONNEMENT=
# Adresses autorisées à appeler l'API (contrôle de l'origine), séparées par des virgules.
ORIGINES_AUTORISEES=
# Durée d'une session de directeur, en heures.
DUREE_SESSION_HEURES=
# Relais https de confiance devant le serveur (Caddy), pour lire l'adresse réelle du client.
RELAIS_DE_CONFIANCE=
NODE_ENV=

# --- Assistant IA (facultatif ; s'active seulement si l'option du lieu l'est) ---
# Clé Mistral, posée par « sudo flaix-admin cle-mistral ».
MISTRAL_API_KEY=
MISTRAL_MODELE=
# Secours OVHcloud AI Endpoints, posé par « sudo flaix-admin cle-ovh-ia ».
OVH_AI_ENDPOINTS_ACCESS_TOKEN=
OVH_AI_MODELE=
# Prix d'un million de jetons (entrée, sortie) pour le compteur de consommation du back-office.
IA_PRIX_ENTREE_MILLION=
IA_PRIX_SORTIE_MILLION=

# --- E-mails par Brevo (facultatif), posés par « sudo flaix-admin cle-brevo » ---
BREVO_API_KEY=
BREVO_EXPEDITEUR=

# --- Cartes Apple Wallet et Google Wallet (facultatif), posées par « sudo flaix-admin wallet-… » ---
# Dossier des certificats et clés sur le serveur (jamais dans le dépôt).
WALLET_DOSSIER=
WALLET_APPLE_TEAM_ID=
WALLET_APPLE_PASS_TYPE_ID=
WALLET_GOOGLE_ISSUER_ID=
